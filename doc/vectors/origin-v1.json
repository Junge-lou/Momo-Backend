{
  "_comment": "评论提交的服务端来源校验（Origin / Referer / post_url）跨语言固定向量。Node / Go / Worker 三端读取同一份 fixture 并各自复算 parseOriginLike / parseAllowedOrigins / checkRequestSource。背景：CORS 只是浏览器机制，allow_origin 白名单过去只决定要不要下发 Access-Control-Allow-Origin，对『服务端到服务端转发』完全无效——对方站点只要在自己的 Worker 里转发一次请求，就能借别人的 SMTP 发通知信。因此 allow_origin 非空且不含 * 时，写接口必须自己做一次来源校验。任何一端改了 scheme/端口归一、host-only 条目语义、无效来源的失败姿态（fail-closed）或决策码，都会立刻在这里暴露。语义见 doc/api.md。",
  "decisions": {
    "skip": "skip",
    "allow": "allow",
    "noSource": "deny:no_source",
    "invalidSource": "deny:invalid_source",
    "notAllowed": "deny:not_allowed"
  },
  "normalize": [
    { "name": "标准 https 来源", "raw": "https://a.com", "want": "https://a.com" },
    { "name": "scheme 与主机大小写归一", "raw": "HTTPS://A.CoM", "want": "https://a.com" },
    { "name": "去掉尾斜杠", "raw": "https://a.com/", "want": "https://a.com" },
    { "name": "路径 / 查询串 / 片段对来源无意义", "raw": "https://a.com/blog/post?x=1#f", "want": "https://a.com" },
    { "name": "https 默认端口 443 归一掉", "raw": "https://a.com:443", "want": "https://a.com" },
    { "name": "http 默认端口 80 归一掉", "raw": "http://a.com:80", "want": "http://a.com" },
    { "name": "非默认端口保留", "raw": "http://a.com:8080", "want": "http://a.com:8080" },
    { "name": "子域与自定义端口", "raw": "https://www.a.com:8443/x", "want": "https://www.a.com:8443" },
    { "name": "IPv6 字面量带端口", "raw": "http://[::1]:17171/", "want": "http://[::1]:17171" },
    { "name": "IPv6 字面量不带端口", "raw": "http://[::1]/", "want": "http://[::1]" },
    { "name": "userinfo 被丢弃", "raw": "https://user:pw@a.com/x", "want": "https://a.com" },
    { "name": "解析器本身不限制 scheme", "raw": "ftp://a.com", "want": "ftp://a.com" },
    { "name": "origin 头里的 null 无法解析", "raw": "null", "want": null },
    { "name": "空串无法解析", "raw": "", "want": null },
    { "name": "缺少 scheme 无法解析", "raw": "a.com", "want": null },
    { "name": "只有 scheme 与分隔符无法解析", "raw": "https://", "want": null },
    { "name": "非数字端口无法解析", "raw": "https://a.com:abc", "want": null },
    { "name": "端口 0 无法解析", "raw": "https://a.com:0", "want": null },
    { "name": "端口前导零无法解析", "raw": "https://a.com:0443", "want": null },
    { "name": "端口越界无法解析", "raw": "https://a.com:70000", "want": null },
    { "name": "裸 IPv6（无方括号）无法解析", "raw": "http://::1/", "want": null },
    { "name": "缺右方括号无法解析", "raw": "http://[::1", "want": null },
    { "name": "内部空白无法解析", "raw": "https://a b.com", "want": null },
    { "name": "非 ASCII 主机无法解析（应使用 punycode）", "raw": "https://中文.com", "want": null },
    { "name": "多余冒号无法解析", "raw": "https://a.com:8080:9090", "want": null }
  ],
  "decide": [
    { "name": "未配置 allow_origin 时不做服务端校验", "allowOrigin": "", "origin": "https://evil.example", "referer": "", "postUrl": "", "want": "skip" },
    { "name": "allow_origin 只有空白时不做校验", "allowOrigin": "   ", "origin": "https://evil.example", "referer": "", "postUrl": "", "want": "skip" },
    { "name": "allow_origin 为 * 时不做校验", "allowOrigin": " * ", "origin": "https://evil.example", "referer": "", "postUrl": "", "want": "skip" },
    { "name": "白名单里混有 * 时同样不做校验", "allowOrigin": "https://a.com,*", "origin": "https://evil.example", "referer": "", "postUrl": "", "want": "skip" },
    { "name": "Origin 精确命中", "allowOrigin": "https://a.com", "origin": "https://a.com", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "Origin 命中（大小写与尾斜杠差异不算差异）", "allowOrigin": "https://A.com/", "origin": "https://a.com", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "Origin 命中（默认端口归一）", "allowOrigin": "https://a.com", "origin": "https://a.com:443", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "不带 scheme 的白名单条目按主机名匹配", "allowOrigin": "a.com", "origin": "https://a.com", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "不带 scheme 的条目不匹配子域", "allowOrigin": "a.com", "origin": "https://www.a.com", "referer": "", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "不带 scheme 的条目忽略端口", "allowOrigin": "a.com", "origin": "https://a.com:8443", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "带 www 的条目同样不匹配裸域", "allowOrigin": "www.a.com", "origin": "https://a.com", "referer": "", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "scheme 不同视为不匹配", "allowOrigin": "https://a.com", "origin": "http://a.com", "referer": "", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "端口不同视为不匹配", "allowOrigin": "http://localhost:17171", "origin": "http://localhost:3000", "referer": "", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "端口相同则放行", "allowOrigin": "http://localhost:17171", "origin": "http://localhost:17171", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "IP 白名单同样按 origin 匹配", "allowOrigin": "http://127.0.0.1:17171", "origin": "http://127.0.0.1:17171", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "只有 Referer 时按 Referer 判定", "allowOrigin": "https://a.com", "origin": "", "referer": "https://a.com/blog/x?y=1", "postUrl": "", "want": "allow" },
    { "name": "三个来源都不存在时拒绝", "allowOrigin": "https://a.com", "origin": "", "referer": "", "postUrl": "", "want": "deny:no_source" },
    { "name": "Origin: null 视为不可解析并要求拒绝", "allowOrigin": "https://a.com", "origin": "null", "referer": "", "postUrl": "", "want": "deny:invalid_source" },
    { "name": "post_url 是相对路径时视为不可解析", "allowOrigin": "https://a.com", "origin": "https://a.com", "referer": "", "postUrl": "/blog/x", "want": "deny:invalid_source" },
    { "name": "Origin 不可解析时即使 post_url 命中也要拒绝（fail-closed）", "allowOrigin": "https://a.com", "origin": "null", "referer": "", "postUrl": "https://a.com/x", "want": "deny:invalid_source" },
    { "name": "候选项 scheme 不是 http(s) 时视为不可解析", "allowOrigin": "ftp://a.com", "origin": "", "referer": "", "postUrl": "ftp://a.com", "want": "deny:invalid_source" },
    { "name": "服务端转发：无 Origin/Referer，仅 post_url 命中", "allowOrigin": "https://ffaff.fun", "origin": "", "referer": "", "postUrl": "https://ffaff.fun/blog/x", "want": "allow" },
    { "name": "服务端转发：post_url 指向未授权站点（本次事件的形态）", "allowOrigin": "https://ffaff.fun,https://www.ffaff.fun", "origin": "", "referer": "", "postUrl": "https://luoxuedev.top/blog/aosp-stage1-environment", "want": "deny:not_allowed" },
    { "name": "Origin 命中但 Referer 不命中时仍拒绝", "allowOrigin": "https://a.com", "origin": "https://a.com", "referer": "https://evil.example/x", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "Origin 不命中但 post_url 命中时仍拒绝", "allowOrigin": "https://a.com, https://b.com", "origin": "https://evil.example", "referer": "", "postUrl": "https://a.com/x", "want": "deny:not_allowed" },
    { "name": "userinfo 伪造不生效（真正的主机不在白名单）", "allowOrigin": "https://a.com", "origin": "https://a.com@evil.example/", "referer": "", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "userinfo 被忽略（真正的主机在白名单）", "allowOrigin": "https://a.com", "origin": "https://evil.example@a.com/", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "多域名白名单", "allowOrigin": "https://a.com, https://b.com", "origin": "https://b.com", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "白名单里的空项与空白不影响判定", "allowOrigin": " https://a.com , , https://b.com, ", "origin": "https://b.com", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "白名单条目带路径时按 origin 归一", "allowOrigin": "https://a.com/blog", "origin": "https://a.com", "referer": "", "postUrl": "", "want": "allow" },
    { "name": "白名单条目全部非法时 fail-closed（全部拒绝）", "allowOrigin": "https://", "origin": "https://a.com", "referer": "", "postUrl": "", "want": "deny:not_allowed" },
    { "name": "未配置白名单时即使 post_url 指向别处也不校验", "allowOrigin": "", "origin": "", "referer": "", "postUrl": "https://evil.example/x", "want": "skip" }
  ]
}
